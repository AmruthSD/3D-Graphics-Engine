#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba32f) uniform image2D resultImage;

struct Triangle {
    vec3 v0;
    vec3 v1;
    vec3 v2;
};

layout(std430, binding = 1) buffer TriangleBuffer {
    Triangle triangles[];
};


struct BVHNode {
    vec3 minBounds;
    vec3 maxBounds;
    int leftFirst;
    int count;      // >0 = leaf
};

layout(std430, binding = 2) buffer BVHBuffer {
    BVHNode nodes[];
};

layout(binding = 3) uniform ComputeUBO {
    mat4 invViewProj;
    vec3 cameraPos;
    vec3 lightDir;
    vec2 resolution;
} ubo;

struct Ray {
    vec3 origin;
    vec3 dir;
};

bool intersectAABB(Ray ray, vec3 minB, vec3 maxB)
{
    vec3 invDir = 1.0 / ray.dir;

    vec3 t0 = (minB - ray.origin) * invDir;
    vec3 t1 = (maxB - ray.origin) * invDir;

    vec3 tmin = min(t0, t1);
    vec3 tmax = max(t0, t1);

    float tNear = max(max(tmin.x, tmin.y), tmin.z);
    float tFar  = min(min(tmax.x, tmax.y), tmax.z);

    return tFar >= max(tNear, 0.0);
}

bool intersectTriangle(Ray ray, Triangle tri, out float tHit, out vec3 normal)
{
    vec3 edge1 = tri.v1 - tri.v0;
    vec3 edge2 = tri.v2 - tri.v0;

    vec3 pvec = cross(ray.dir, edge2);
    float det = dot(edge1, pvec);

    if (abs(det) < 1e-6)
        return false;

    float invDet = 1.0 / det;

    vec3 tvec = ray.origin - tri.v0;
    float u = dot(tvec, pvec) * invDet;
    if (u < 0.0 || u > 1.0)
        return false;

    vec3 qvec = cross(tvec, edge1);
    float v = dot(ray.dir, qvec) * invDet;
    if (v < 0.0 || u + v > 1.0)
        return false;

    tHit = dot(edge2, qvec) * invDet;
    if (tHit < 0.0)
        return false;

    normal = normalize(cross(edge1, edge2));
    return true;
}


Ray generateRay(vec2 pixel)
{
    vec2 ndc = (pixel / ubo.resolution) * 2.0 - 1.0;

    vec4 clip = vec4(ndc, 0.0, 1.0);
    vec4 world = ubo.invViewProj * clip;
    world /= world.w;

    vec3 dir = normalize(world.xyz - ubo.cameraPos);

    Ray ray;
    ray.origin = ubo.cameraPos;
    ray.dir = dir;

    return ray;
}


bool traverseBVH(Ray ray, out float closestT, out vec3 hitNormal)
{
    closestT = 1e30;
    bool hit = false;

    int stack[64];
    int stackPtr = 0;

    stack[stackPtr++] = 0; // root

    while (stackPtr > 0)
    {
        int nodeIndex = stack[--stackPtr];
        BVHNode node = nodes[nodeIndex];

        if (!intersectAABB(ray, node.minBounds, node.maxBounds))
            continue;

        if (node.count > 0)
        {
            // leaf
            for (int i = 0; i < node.count; i++)
            {
                float t;
                vec3 normal;

                if (intersectTriangle(ray,
                                      triangles[node.leftFirst + i],
                                      t, normal))
                {
                    if (t < closestT)
                    {
                        closestT = t;
                        hitNormal = normal;
                        hit = true;
                    }
                }
            }
        }
        else
        {
            // internal node
            stack[stackPtr++] = node.leftFirst;
            stack[stackPtr++] = node.leftFirst + 1;
        }
    }

    return hit;
}


void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);

    if (pixel.x >= int(ubo.resolution.x) ||
        pixel.y >= int(ubo.resolution.y))
        return;

    Ray ray = generateRay(vec2(pixel) + 0.5);

    float t;
    vec3 normal;

    vec3 color = vec3(0.7, 0.8, 1.0); // sky

    if (traverseBVH(ray, t, normal))
    {
        float NdotL = max(dot(normal, -normalize(ubo.lightDir)), 0.0);
        color = vec3(0.3, 0.8, 0.3) * NdotL;
    }

    imageStore(resultImage, pixel, vec4(color, 1.0));
}